{
    "name": "seo.deep",
    "title": "Deepest pages of a class",
    "purpose": "The nodes of one class that sit deepest in the tree (more clicks from the front page), deepest first.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "seo",
        "urls",
        "structure"
    ],
    "use_case": "Flattening the site structure",
    "parameters": {
        "class": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,100}$",
            "default": "ng_article",
            "description": "The class, e.g. ng_article or folder.",
            "examples": [
                "ng_article",
                "folder"
            ],
            "short": "-c"
        },
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 2,
            "description": "The node to start from.",
            "examples": [
                2
            ]
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "node_find"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "find",
            "unit": "node_find",
            "args": {
                "node_id": "$param.node_id",
                "class": "$param.class",
                "limit": 50
            }
        },
        {
            "id": "o0",
            "op": "sort",
            "from": "$steps.find.items",
            "by": "depth",
            "order": "desc"
        },
        {
            "id": "o1",
            "op": "limit",
            "from": "$steps.o0",
            "count": 15
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.o1",
            "fields": [
                "node_id",
                "name",
                "url_alias",
                "depth"
            ]
        }
    ],
    "output": {
        "value": {
            "total": "$steps.find.total",
            "shown": "$steps.rows|count",
            "nodes": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "total",
                "shown",
                "nodes"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "description": "How many match in all"
                },
                "shown": {
                    "type": "integer"
                },
                "nodes": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Deep folders",
            "params": {
                "class": "folder"
            }
        },
        {
            "title": "Deep articles",
            "params": {
                "class": "ng_article"
            }
        },
        {
            "title": "Deep blog posts",
            "params": {
                "class": "ng_blog_post"
            }
        },
        {
            "title": "Deep landing pages",
            "params": {
                "class": "ng_landing_page"
            }
        },
        {
            "title": "Deep news",
            "params": {
                "class": "ng_news"
            }
        },
        {
            "title": "Deep recipes",
            "params": {
                "class": "ng_recipe"
            }
        }
    ]
}
