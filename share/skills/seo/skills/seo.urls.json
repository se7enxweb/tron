{
    "name": "seo.urls",
    "title": "URLs of a class",
    "purpose": "The URL aliases of the nodes of one class below a node, to check them for readable, stable addresses.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "seo",
        "urls",
        "inventory"
    ],
    "use_case": "Reviewing URLs before a launch",
    "parameters": {
        "class": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,100}$",
            "default": "ng_article",
            "description": "The class, e.g. ng_article or folder.",
            "examples": [
                "ng_article",
                "folder"
            ],
            "short": "-c"
        },
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 2,
            "description": "The node to start from.",
            "examples": [
                2
            ]
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 50,
            "description": "At most this many rows in the answer.",
            "examples": [
                5,
                50
            ],
            "short": "-n"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "node_find"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "find",
            "unit": "node_find",
            "args": {
                "node_id": "$param.node_id",
                "class": "$param.class",
                "limit": "$param.limit",
                "sort": "path",
                "order": "asc"
            }
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.find.items",
            "fields": [
                "node_id",
                "name",
                "url_alias",
                "depth"
            ]
        }
    ],
    "output": {
        "value": {
            "total": "$steps.find.total",
            "shown": "$steps.rows|count",
            "nodes": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "total",
                "shown",
                "nodes"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "description": "How many match in all"
                },
                "shown": {
                    "type": "integer"
                },
                "nodes": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "URLs of folders",
            "params": {
                "class": "folder"
            }
        },
        {
            "title": "URLs of articles",
            "params": {
                "class": "ng_article"
            }
        },
        {
            "title": "URLs of blog posts",
            "params": {
                "class": "ng_blog_post"
            }
        },
        {
            "title": "URLs of landing pages",
            "params": {
                "class": "ng_landing_page"
            }
        },
        {
            "title": "URLs of news",
            "params": {
                "class": "ng_news"
            }
        },
        {
            "title": "URLs of recipes",
            "params": {
                "class": "ng_recipe"
            }
        }
    ]
}
