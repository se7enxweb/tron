    "purpose": "The tools a program left out on purpose here, with the reason (a missing extension or source).",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "ops",
        "tron",
        "tools"
    ],
    "use_case": "Why is a tool missing?",
    "parameters": {},
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "tron_status"
        ],
        "wave": "A"
    },
    "steps": [
