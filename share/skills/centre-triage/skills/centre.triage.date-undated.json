{
    "name": "centre.triage.date-undated",
    "title": "Date the undated",
    "purpose": "Gives every open ticket of a board without a due date the due date a number of days from today.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "triage",
        "writes"
    ],
    "use_case": "Backlog grooming",
    "parameters": {
        "board": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "main",
            "description": "The centre board, e.g. main or ops.",
            "examples": [
                "main",
                "ops"
            ],
            "short": "-b"
        },
        "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90,
            "default": 14,
            "description": "Due this many days from today.",
            "examples": [
                14
            ]
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_list",
            "centre_ticket_update"
        ],
        "programs": [
            "centre"
        ],
        "wave": "B"
    },
    "guards": [
        {
            "policy": "tron/centre_write"
        }
    ],
    "steps": [
        {
            "id": "list",
            "unit": "centre_ticket_list",
            "args": {
                "board": "$param.board",
                "status": "open",
                "limit": 200
            }
        },
        {
            "id": "undated",
            "op": "where",
            "from": "$steps.list.items",
            "field": "due",
            "cmp": "empty"
        },
        {
            "id": "dated",
            "op": "each",
            "from": "$steps.undated",
            "unit": "centre_ticket_update",
            "args": {
                "id": "$item.id",
                "due": "$ahead.days"
            },
            "max": 25
        }
    ],
    "output": {
        "value": {
            "dated": "$steps.dated|count"
        },
        "schema": {
            "type": "object",
            "required": [
                "dated"
            ],
            "properties": {
                "dated": {
                    "type": "integer"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With board main",
            "params": {
                "board": "main"
            }
        }
    ]
}
