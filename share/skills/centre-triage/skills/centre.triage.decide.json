{
    "name": "centre.triage.decide",
    "title": "Record a decision",
    "purpose": "Records the decision of an open decision ticket and closes it.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "triage",
        "writes"
    ],
    "use_case": "The decision meeting",
    "parameters": {
        "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 1,
            "description": "The decision ticket.",
            "examples": [
                11
            ]
        },
        "decision": {
            "type": "string",
            "minLength": 3,
            "maxLength": 4000,
            "default": "Agreed.",
            "description": "What was decided.",
            "examples": [
                "Agreed: PHP 8.5 on every node."
            ]
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_decision_record"
        ],
        "programs": [
            "centre"
        ],
        "wave": "B"
    },
    "guards": [
        {
            "policy": "tron/centre_write"
        }
    ],
    "steps": [
        {
            "id": "rec",
            "unit": "centre_decision_record",
            "args": {
                "id": "$param.id",
                "decision": "$param.decision"
            }
        }
    ],
    "output": {
        "value": {
            "decision": "$steps.rec"
        },
        "schema": {
            "type": "object",
            "required": [
                "decision"
            ],
            "properties": {
                "decision": {
                    "type": "object"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With id 11, decision Agreed: PHP 8.5 on every node.",
            "params": {
                "id": 11,
                "decision": "Agreed: PHP 8.5 on every node."
            }
        }
    ]
}
