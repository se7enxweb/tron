{
    "name": "centre.triage.raise-overdue-high",
    "title": "Raise overdue high tickets",
    "purpose": "Raises the priority of the overdue open high tickets of a board by one step.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "triage",
        "writes"
    ],
    "use_case": "Escalating late work",
    "parameters": {
        "board": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "main",
            "description": "The centre board, e.g. main or ops.",
            "examples": [
                "main",
                "ops"
            ],
            "short": "-b"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_list",
            "centre_ticket_update"
        ],
        "programs": [
            "centre"
        ],
        "wave": "B"
    },
    "guards": [
        {
            "policy": "tron/centre_write"
        }
    ],
    "steps": [
        {
            "id": "list",
            "unit": "centre_ticket_list",
            "args": {
                "board": "$param.board",
                "status": "open",
                "limit": 200
            }
        },
        {
            "id": "p",
            "op": "where",
            "from": "$steps.list.items",
            "field": "priority",
            "cmp": "eq",
            "value": "high"
        },
        {
            "id": "dated",
            "op": "where",
            "from": "$steps.p",
            "field": "due",
            "cmp": "notempty"
        },
        {
            "id": "late",
            "op": "where",
            "from": "$steps.dated",
            "field": "due",
            "cmp": "lt",
            "value": "$today"
        },
        {
            "id": "raised",
            "op": "each",
            "from": "$steps.late",
            "unit": "centre_ticket_update",
            "args": {
                "id": "$item.id",
                "priority": "urgent"
            },
            "max": 25
        }
    ],
    "output": {
        "value": {
            "raised": "$steps.raised|count"
        },
        "schema": {
            "type": "object",
            "required": [
                "raised"
            ],
            "properties": {
                "raised": {
                    "type": "integer"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With board main",
            "params": {
                "board": "main"
            }
        }
    ]
}
