{
    "name": "centre.triage.close-done",
    "title": "Close what is done",
    "purpose": "Closes every open ticket of a board that sits in the lane done, with the reason done.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "triage",
        "writes"
    ],
    "use_case": "End of sprint",
    "parameters": {
        "board": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "main",
            "description": "The centre board, e.g. main or ops.",
            "examples": [
                "main",
                "ops"
            ],
            "short": "-b"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_list",
            "centre_ticket_close"
        ],
        "programs": [
            "centre"
        ],
        "wave": "B"
    },
    "guards": [
        {
            "policy": "tron/centre_write"
        }
    ],
    "steps": [
        {
            "id": "list",
            "unit": "centre_ticket_list",
            "args": {
                "lane": "done",
                "board": "$param.board",
                "status": "open",
                "limit": 200
            }
        },
        {
            "id": "closed",
            "op": "each",
            "from": "$steps.list.items",
            "unit": "centre_ticket_close",
            "args": {
                "id": "$item.id",
                "reason": "done"
            },
            "max": 50
        }
    ],
    "output": {
        "value": {
            "closed": "$steps.closed|count"
        },
        "schema": {
            "type": "object",
            "required": [
                "closed"
            ],
            "properties": {
                "closed": {
                    "type": "integer"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With board main",
            "params": {
                "board": "main"
            }
        }
    ]
}
