{
    "name": "centre.triage.move-inbox-to-next",
    "title": "Move inbox to next",
    "purpose": "Moves every open ticket of a board from the lane inbox to the lane next, at most a given number per run.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "triage",
        "writes"
    ],
    "use_case": "Tidying the inbox lane",
    "parameters": {
        "board": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "main",
            "description": "The centre board, e.g. main or ops.",
            "examples": [
                "main",
                "ops"
            ],
            "short": "-b"
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "At most this many rows in the answer.",
            "examples": [
                5,
                10
            ],
            "short": "-n"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_list",
            "centre_ticket_move"
        ],
        "programs": [
            "centre"
        ],
        "wave": "B"
    },
    "guards": [
        {
            "policy": "tron/centre_write"
        }
    ],
    "steps": [
        {
            "id": "list",
            "unit": "centre_ticket_list",
            "args": {
                "lane": "inbox",
                "board": "$param.board",
                "status": "open",
                "limit": 200
            }
        },
        {
            "id": "top",
            "op": "limit",
            "from": "$steps.list.items",
            "count": "$param.limit"
        },
        {
            "id": "moved",
            "op": "each",
            "from": "$steps.top",
            "unit": "centre_ticket_move",
            "args": {
                "id": "$item.id",
                "lane": "next"
            },
            "max": 50
        }
    ],
    "output": {
        "value": {
            "moved": "$steps.moved|count"
        },
        "schema": {
            "type": "object",
            "required": [
                "moved"
            ],
            "properties": {
                "moved": {
                    "type": "integer"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With board main",
            "params": {
                "board": "main"
            }
        }
    ]
}
