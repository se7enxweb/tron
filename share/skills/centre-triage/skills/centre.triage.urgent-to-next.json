{
    "name": "centre.triage.urgent-to-next",
    "title": "Urgent inbox to next",
    "purpose": "Moves the urgent tickets of the inbox of a board to the lane next so they are planned first.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "triage",
        "writes"
    ],
    "use_case": "Daily triage",
    "parameters": {
        "board": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "main",
            "description": "The centre board, e.g. main or ops.",
            "examples": [
                "main",
                "ops"
            ],
            "short": "-b"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_list",
            "centre_ticket_move"
        ],
        "programs": [
            "centre"
        ],
        "wave": "B"
    },
    "guards": [
        {
            "policy": "tron/centre_write"
        }
    ],
    "steps": [
        {
            "id": "list",
            "unit": "centre_ticket_list",
            "args": {
                "lane": "inbox",
                "board": "$param.board",
                "status": "open",
                "limit": 200
            }
        },
        {
            "id": "urgent",
            "op": "where",
            "from": "$steps.list.items",
            "field": "priority",
            "cmp": "eq",
            "value": "urgent"
        },
        {
            "id": "moved",
            "op": "each",
            "from": "$steps.urgent",
            "unit": "centre_ticket_move",
            "args": {
                "id": "$item.id",
                "lane": "next"
            },
            "max": 25
        }
    ],
    "output": {
        "value": {
            "moved": "$steps.moved|count"
        },
        "schema": {
            "type": "object",
            "required": [
                "moved"
            ],
            "properties": {
                "moved": {
                    "type": "integer"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With board main",
            "params": {
                "board": "main"
            }
        }
    ]
}
