{
    "name": "ini.setting",
    "title": "One setting and where it is set",
    "purpose": "The value of one setting (file, block, setting) as a siteaccess resolves it, and every file that sets it.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "ini",
        "settings"
    ],
    "use_case": "Answering \"where is this set?\"",
    "parameters": {
        "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}\\.ini$",
            "default": "site.ini",
            "description": "The INI file, e.g. site.ini.",
            "examples": [
                "site.ini",
                "image.ini"
            ],
            "short": "-f"
        },
        "block": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "default": "SiteSettings",
            "description": "The block, e.g. SiteSettings.",
            "examples": [
                "SiteSettings",
                "DatabaseSettings"
            ]
        },
        "setting": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "default": "SiteName",
            "description": "The setting, e.g. SiteName.",
            "examples": [
                "SiteName",
                "SiteURL"
            ]
        },
        "siteaccess": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "The siteaccess whose settings count (default: the current one).",
            "examples": [
                "site",
                "admin"
            ],
            "short": "-s",
            "default": "site"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "ini_resolve"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "r",
            "unit": "ini_resolve",
            "args": {
                "file": "$param.file",
                "block": "$param.block",
                "setting": "$param.setting",
                "siteaccess": "$param.siteaccess"
            }
        },
        {
            "id": "chain",
            "op": "pick",
            "from": "$steps.r.files",
            "fields": [
                "path",
                "scope",
                "value"
            ]
        }
    ],
    "output": {
        "value": {
            "setting": "{{$param.file}} [{{$param.block}}] {{$param.setting}}",
            "siteaccess": "$steps.r.siteaccess",
            "found": "$steps.r.found",
            "value": "$steps.r.value",
            "winner": "$steps.r.winner",
            "files": "$steps.chain"
        },
        "schema": {
            "type": "object",
            "required": [
                "setting",
                "siteaccess",
                "found",
                "value",
                "winner",
                "files"
            ],
            "properties": {
                "setting": {
                    "type": "string"
                },
                "siteaccess": {
                    "type": "string"
                },
                "found": {
                    "type": "boolean"
                },
                "value": [],
                "winner": [],
                "files": {
                    "type": "array",
                    "description": "Every file that sets it, lowest first"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Siteaccess extensions",
            "params": {
                "siteaccess": "site",
                "file": "site.ini",
                "block": "ExtensionSettings",
                "setting": "ActiveAccessExtensions"
            }
        },
        {
            "title": "Active extensions",
            "params": {
                "siteaccess": "site",
                "file": "site.ini",
                "block": "ExtensionSettings",
