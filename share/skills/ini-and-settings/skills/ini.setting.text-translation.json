{
    "name": "ini.setting.text-translation",
    "title": "Text translation",
    "purpose": "Whether interface texts are translated for a siteaccess. Shows the winning value and every file that sets it.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "ini",
        "settings",
        "site"
    ],
    "use_case": "Answering \"where is this set?\"",
    "parameters": {
        "siteaccess": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "The siteaccess whose settings count (default: the current one).",
            "examples": [
                "site",
                "admin"
            ],
            "short": "-s",
            "default": "site"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "ini_resolve"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "r",
            "unit": "ini_resolve",
            "args": {
                "file": "site.ini",
                "block": "RegionalSettings",
                "setting": "TextTranslation",
                "siteaccess": "$param.siteaccess"
            }
        },
        {
            "id": "chain",
            "op": "pick",
            "from": "$steps.r.files",
            "fields": [
                "path",
                "scope",
                "value"
            ]
        }
    ],
    "output": {
        "value": {
            "setting": "site.ini [RegionalSettings] TextTranslation",
            "siteaccess": "$steps.r.siteaccess",
            "found": "$steps.r.found",
            "value": "$steps.r.value",
            "winner": "$steps.r.winner",
            "files": "$steps.chain"
        },
        "schema": {
            "type": "object",
            "required": [
                "setting",
                "siteaccess",
                "found",
                "value",
                "winner",
                "files"
            ],
            "properties": {
                "setting": {
                    "type": "string"
                },
                "siteaccess": {
                    "type": "string"
                },
                "found": {
                    "type": "boolean"
                },
                "value": [],
                "winner": [],
                "files": {
                    "type": "array",
                    "description": "Every file that sets it, lowest first"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With siteaccess site",
            "params": {
                "siteaccess": "site"
            }
        },
        {
            "title": "With siteaccess admin",
            "params": {
                "siteaccess": "admin"
            }
        }
    ]
}
