{
    "name": "ini.diff",
    "title": "Compare an INI file of two siteaccesses",
    "purpose": "Compares an INI file as two siteaccesses resolve it: which settings differ, and which exist in only one of them.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "ini",
        "diff"
    ],
    "use_case": "Why does this siteaccess behave differently?",
    "parameters": {
        "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}\\.ini$",
            "default": "site.ini",
            "description": "The INI file, e.g. site.ini or content.ini.",
            "examples": [
                "site.ini",
                "content.ini"
            ],
            "short": "-f"
        },
        "a": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "default": "site",
            "description": "The first siteaccess.",
            "examples": [
                "site"
            ]
        },
        "b": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "default": "admin",
            "description": "The second siteaccess.",
            "examples": [
                "admin"
            ]
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "At most this many rows in the answer.",
            "examples": [
                5,
                100
            ],
            "short": "-n"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "ini_diff"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "d",
            "unit": "ini_diff",
            "args": {
                "file": "$param.file",
                "a": "$param.a",
                "b": "$param.b",
                "limit": "$param.limit"
            }
        },
        {
            "id": "blocks",
            "op": "group",
            "from": "$steps.d.items",
            "by": "block"
        }
    ],
    "output": {
        "value": {
            "file": "$param.file",
            "a": "$param.a",
            "b": "$param.b",
            "counts": "$steps.d.counts",
            "per_block": "$steps.blocks",
            "differences": "$steps.d.items"
        },
        "schema": {
            "type": "object",
            "required": [
                "file",
                "a",
                "b",
                "counts",
                "per_block",
                "differences"
            ],
            "properties": {
                "file": {
                    "type": "string"
                },
                "a": {
                    "type": "string"
                },
                "b": {
                    "type": "string"
                },
                "counts": {
                    "type": "object"
                },
                "per_block": {
                    "type": "array"
                },
                "differences": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Compare content.ini of two siteaccesses",
            "params": {
                "a": "site",
                "b": "admin",
                "limit": 50,
                "file": "content.ini"
            }
        },
        {
            "title": "Compare design.ini of two siteaccesses",
            "params": {
                "a": "site",
                "b": "admin",
                "limit": 50,
                "file": "design.ini"
            }
        },
        {
            "title": "Compare explayouts.ini of two siteaccesses",
            "params": {
                "a": "site",
                "b": "admin",
                "limit": 50,
                "file": "explayouts.ini"
            }
        },
        {
            "title": "Compare image.ini of two siteaccesses",
            "params": {
                "a": "site",
                "b": "admin",
                "limit": 50,
                "file": "image.ini"
            }
        },
        {
            "title": "Compare menu.ini of two siteaccesses",
            "params": {
                "a": "site",
                "b": "admin",
                "limit": 50,
                "file": "menu.ini"
            }
        },
        {
            "title": "Compare override.ini of two siteaccesses",
            "params": {
                "a": "site",
                "b": "admin",
                "limit": 50,
                "file": "override.ini"
            }
        },
        {
            "title": "Compare site.ini of two siteaccesses",
            "params": {
                "a": "site",
                "b": "admin",
                "limit": 50,
                "file": "site.ini"
            }
        },
        {
            "title": "Compare toolbar.ini of two siteaccesses",
            "params": {
                "a": "site",
                "b": "admin",
                "limit": 50,
                "file": "toolbar.ini"
            }
        }
    ]
}
