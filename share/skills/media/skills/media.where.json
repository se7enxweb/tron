{
    "name": "media.where",
    "title": "Where media of a class lives",
    "purpose": "In which parent nodes the media objects of one class (image, file, ng_video ...) sit, with how many in each (from the first 50).",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "media",
        "inventory",
        "structure"
    ],
    "use_case": "Finding the media folders",
    "parameters": {
        "class": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,100}$",
            "default": "image",
            "description": "The media class, e.g. image, file or ng_video.",
            "examples": [
                "image",
                "file"
            ],
            "short": "-c"
        },
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 1,
            "description": "The node to start from.",
            "examples": [
                1
            ]
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "node_find"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "f",
            "unit": "node_find",
            "args": {
                "node_id": "$param.node_id",
                "class": "$param.class",
                "limit": 50
            }
        },
        {
            "id": "g",
            "op": "group",
            "from": "$steps.f.items",
            "by": "parent_node_id"
        }
    ],
    "output": {
        "value": {
            "total": "$steps.f.total",
            "per_parent": "$steps.g"
        },
        "schema": {
            "type": "object",
            "required": [
                "total",
                "per_parent"
            ],
            "properties": {
                "total": {
                    "type": "integer"
                },
                "per_parent": {
                    "type": "array",
                    "description": "parent node id and count"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Files per folder",
            "params": {
                "class": "file"
            }
        },
        {
            "title": "Images per folder",
            "params": {
                "class": "image"
            }
        },
        {
            "title": "Audio items per folder",
            "params": {
                "class": "ng_audio"
            }
        },
        {
            "title": "Banners per folder",
            "params": {
                "class": "ng_banner"
            }
        },
        {
            "title": "Galleries per folder",
            "params": {
                "class": "ng_gallery"
            }
        },
        {
            "title": "Logos per folder",
            "params": {
                "class": "ng_logo"
            }
        },
        {
            "title": "Videos per folder",
            "params": {
                "class": "ng_video"
            }
        }
    ]
}
