{
    "name": "i18n.siteaccess.admin",
    "title": "Languages of admin",
    "purpose": "The locale, content language and site languages of the siteaccess admin, with the files that set them.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "i18n",
        "languages",
        "siteaccess"
    ],
    "use_case": "Checking a translated site",
    "parameters": {},
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "ini_resolve"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "loc",
            "unit": "ini_resolve",
            "args": {
                "file": "site.ini",
                "block": "RegionalSettings",
                "setting": "Locale",
                "siteaccess": "admin"
            }
        },
        {
            "id": "col",
            "unit": "ini_resolve",
            "args": {
                "file": "site.ini",
                "block": "RegionalSettings",
                "setting": "ContentObjectLocale",
                "siteaccess": "admin"
            }
        },
        {
            "id": "sll",
            "unit": "ini_resolve",
            "args": {
                "file": "site.ini",
                "block": "RegionalSettings",
                "setting": "SiteLanguageList",
                "siteaccess": "admin"
            }
        }
    ],
    "output": {
        "value": {
            "siteaccess": "admin",
            "locale": "$steps.loc.value",
            "content_language": "$steps.col.value",
            "site_languages": "$steps.sll.value",
            "set_in": "$steps.sll.winner"
        },
        "schema": {
            "type": "object",
            "required": [
                "siteaccess",
                "locale",
                "content_language",
                "site_languages",
                "set_in"
            ],
            "properties": {
                "siteaccess": {
                    "type": "string"
                },
                "locale": [],
                "content_language": [],
                "site_languages": [],
                "set_in": []
            }
        }
    },
    "examples": [
        {
            "title": "With the defaults",
            "params": {}
        }
    ]
}
