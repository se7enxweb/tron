{
    "name": "centre.count.overdue-by-lane",
    "title": "Overdue per lane",
    "purpose": "Counts the overdue open tickets of a board per lane, to see where late work is stuck.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "report",
        "counts",
        "due",
        "lanes"
    ],
    "use_case": "Finding the bottleneck",
    "parameters": {
        "board": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "main",
            "description": "The centre board, e.g. main or ops.",
            "examples": [
                "main",
                "ops"
            ],
            "short": "-b"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_list"
        ],
        "programs": [
            "centre"
        ],
        "wave": "A"
    },
    "guards": [
        {
            "policy": "tron/centre_read"
        }
    ],
    "steps": [
        {
            "id": "list",
            "unit": "centre_ticket_list",
            "args": {
                "board": "$param.board",
                "status": "open",
                "limit": 200
            }
        },
        {
            "id": "w0",
            "op": "where",
            "from": "$steps.list.items",
            "field": "due",
            "cmp": "notempty"
        },
        {
            "id": "w1",
            "op": "where",
            "from": "$steps.w0",
            "field": "due",
            "cmp": "lt",
            "value": "$today"
        },
        {
            "id": "groups",
            "op": "group",
            "from": "$steps.w1",
            "by": "lane"
        }
    ],
    "output": {
        "value": {
            "board": "$param.board",
            "total": "$steps.w1|count",
            "groups": "$steps.groups"
        },
        "schema": {
            "type": "object",
            "required": [
                "board",
                "total",
                "groups"
            ],
            "properties": {
                "board": {
                    "type": "string"
                },
                "total": {
                    "type": "integer"
                },
                "groups": {
                    "type": "array",
                    "description": "key and count, largest first"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With board main",
            "params": {
                "board": "main"
            }
        },
        {
            "title": "With board ops",
            "params": {
                "board": "ops"
            }
        }
    ]
}
