{
    "name": "centre.ticket.links",
    "title": "Ticket links",
    "purpose": "The links of one ticket (commits, URLs, gnubus messages, to-dos, other tickets), grouped by kind.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "ticket",
        "links"
    ],
    "use_case": "Following a ticket to its commits and pages",
    "parameters": {
        "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 1,
            "description": "The ticket id.",
            "examples": [
                1
            ]
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_get"
        ],
        "programs": [
            "centre"
        ],
        "wave": "A"
    },
    "guards": [
        {
            "policy": "tron/centre_read"
        }
    ],
    "steps": [
        {
            "id": "get",
            "unit": "centre_ticket_get",
            "args": {
                "id": "$param.id"
            }
        },
        {
            "id": "kinds",
            "op": "group",
            "from": "$steps.get.links",
            "by": "kind"
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.get.links",
            "fields": [
                "kind",
                "ref",
                "note",
                "at"
            ]
        }
    ],
    "output": {
        "value": {
            "id": "$param.id",
            "links": "$steps.rows",
            "per_kind": "$steps.kinds"
        },
        "schema": {
            "type": "object",
            "required": [
                "id",
                "links",
                "per_kind"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "links": {
                    "type": "array"
                },
                "per_kind": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With id 1",
            "params": {
                "id": 1
            }
        },
        {
            "title": "With id 5",
            "params": {
                "id": 5
            }
        }
    ]
}
