{
    "name": "centre.ticket.digest",
    "title": "Ticket digest",
    "purpose": "One ticket in short: its fields, the number of comments and links, the last comment and the last change.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "ticket",
        "digest"
    ],
    "use_case": "Picking up a ticket someone else started",
    "parameters": {
        "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 1,
            "description": "The ticket id.",
            "examples": [
                1
            ],
            "required": false
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_get"
        ],
        "programs": [
            "centre"
        ],
        "wave": "A"
    },
    "guards": [
        {
            "policy": "tron/centre_read"
        }
    ],
    "steps": [
        {
            "id": "get",
            "unit": "centre_ticket_get",
            "args": {
                "id": "$param.id"
            }
        }
    ],
    "output": {
        "value": {
            "id": "$steps.get.id",
            "title": "$steps.get.title",
            "status": "$steps.get.status",
            "lane": "$steps.get.lane",
            "priority": "$steps.get.priority",
            "assignee": "$steps.get.assignee",
            "comments": "$steps.get.comments|count",
            "links": "$steps.get.links|count",
            "last_comment": "$steps.get.comments|last",
            "last_change": "$steps.get.history|last"
        },
        "schema": {
            "type": "object",
            "required": [
                "id",
                "title",
                "status",
                "lane",
                "priority",
                "assignee",
                "comments",
                "links",
                "last_comment",
                "last_change"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "lane": {
                    "type": "string"
                },
                "priority": {
                    "type": "string"
                },
                "assignee": [],
                "comments": {
                    "type": "integer"
                },
                "links": {
                    "type": "integer"
                },
                "last_comment": [],
                "last_change": []
            }
        }
    },
    "examples": [
        {
            "title": "With id 1",
            "params": {
                "id": 1
            }
        },
        {
            "title": "With id 5",
            "params": {
                "id": 5
            }
        }
    ]
}
