{
    "name": "centre.tickets.search",
    "title": "Search tickets",
    "purpose": "Finds the open tickets of a board whose title holds the given words.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "tickets",
        "search"
    ],
    "use_case": "Finding a ticket by words",
    "parameters": {
        "board": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "main",
            "description": "The centre board, e.g. main or ops.",
            "examples": [
                "main",
                "ops"
            ],
            "short": "-b"
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "At most this many rows in the answer.",
            "examples": [
                5,
                20
            ],
            "short": "-n"
        },
        "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "default": "cache",
            "description": "Words in the title.",
            "examples": [
                "cache",
                "layout"
            ],
            "short": "-q"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_list"
        ],
        "programs": [
            "centre"
        ],
        "wave": "A"
    },
    "guards": [
        {
            "policy": "tron/centre_read"
        }
    ],
    "steps": [
        {
            "id": "list",
            "unit": "centre_ticket_list",
            "args": {
                "query": "$param.query",
                "board": "$param.board",
                "status": "open",
                "limit": 200
            }
        },
        {
            "id": "sorted",
            "op": "sort",
            "from": "$steps.list.items",
            "by": "modified",
            "order": "desc"
        },
        {
            "id": "top",
            "op": "limit",
            "from": "$steps.sorted",
            "count": "$param.limit"
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.top",
            "fields": [
                "id",
                "title",
                "lane",
                "priority",
                "assignee",
                "due"
            ]
        }
    ],
    "output": {
        "value": {
            "board": "$param.board",
            "count": "$steps.list.items|count",
            "tickets": "$steps.rows",
            "summary": "{{$steps.list.total}} open tickets on {{$param.board}} match \"{{$param.query}}\"."
        },
        "schema": {
            "type": "object",
            "required": [
                "board",
                "count",
                "tickets",
                "summary"
            ],
            "properties": {
                "board": {
                    "type": "string"
                },
                "count": {
                    "type": "integer",
                    "description": "How many match (before the limit)"
                },
                "tickets": {
                    "type": "array"
                },
                "summary": {
                    "type": "string"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With board main, query page",
            "params": {
                "board": "main",
                "query": "page"
            }
        },
        {
            "title": "With board ops, query backup",
            "params": {
                "board": "ops",
                "query": "backup"
            }
        }
    ]
}
