{
    "name": "centre.tickets.due-within",
    "title": "Due within some days",
    "purpose": "Lists the open tickets of a board that fall due from today through the next given number of days, soonest first.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "centre",
        "tickets",
        "due",
        "planning"
    ],
    "use_case": "Planning the coming days",
    "parameters": {
        "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "default": 7,
            "description": "How many days ahead, from today.",
            "examples": [
                7,
                14,
                30
            ],
            "short": "-d"
        },
        "board": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "default": "main",
            "description": "The centre board, e.g. main or ops.",
            "examples": [
                "main",
                "ops"
            ],
            "short": "-b"
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "At most this many rows in the answer.",
            "examples": [
                5,
                20
            ],
            "short": "-n"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "centre_ticket_list"
        ],
        "programs": [
            "centre"
        ],
        "wave": "A"
    },
    "guards": [
        {
            "policy": "tron/centre_read"
        }
    ],
    "steps": [
        {
            "id": "list",
            "unit": "centre_ticket_list",
            "args": {
                "board": "$param.board",
                "status": "open",
                "limit": 200
            }
        },
        {
            "id": "w0",
            "op": "where",
            "from": "$steps.list.items",
            "field": "due",
            "cmp": "notempty"
        },
        {
            "id": "w1",
            "op": "where",
            "from": "$steps.w0",
            "field": "due",
            "cmp": "ge",
            "value": "$today"
        },
        {
            "id": "w2",
            "op": "where",
            "from": "$steps.w1",
            "field": "due",
            "cmp": "le",
            "value": "$ahead.days"
        },
        {
            "id": "sorted",
            "op": "sort",
            "from": "$steps.w2",
            "by": "due",
            "order": "asc"
        },
        {
            "id": "top",
            "op": "limit",
            "from": "$steps.sorted",
            "count": "$param.limit"
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.top",
            "fields": [
                "id",
                "title",
                "lane",
                "priority",
                "assignee",
                "due"
            ]
        }
    ],
    "output": {
        "value": {
            "board": "$param.board",
            "count": "$steps.w2|count",
            "tickets": "$steps.rows",
            "summary": "{{$steps.w2|count}} open tickets on {{$param.board}} fall due within {{$param.days}} days."
        },
        "schema": {
            "type": "object",
            "required": [
                "board",
                "count",
                "tickets",
                "summary"
            ],
            "properties": {
                "board": {
                    "type": "string"
                },
                "count": {
                    "type": "integer",
                    "description": "How many match (before the limit)"
                },
                "tickets": {
                    "type": "array"
                },
                "summary": {
                    "type": "string"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Due this week",
            "params": {
                "board": "main",
                "days": 7
            }
        },
        {
            "title": "Due in two weeks",
            "params": {
                "board": "main",
                "days": 14
            }
        },
        {
            "title": "Due this month",
            "params": {
                "board": "main",
                "days": 30
            }
        }
    ]
}
