{
    "name": "layout.blocks.category",
    "title": "Block types of a category",
    "purpose": "The block definitions of one category (text, media, listing, navigation, form, container).",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "layouts",
        "blocks",
        "inventory"
    ],
    "use_case": "Choosing a block for a zone",
    "parameters": {
        "category": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$",
            "default": "text",
            "description": "The block category, e.g. text, media or listing.",
            "examples": [
                "text",
                "listing"
            ],
            "short": "-c"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "layout_block_definitions"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "d",
            "unit": "layout_block_definitions",
            "args": {}
        },
        {
            "id": "o0",
            "op": "where",
            "from": "$steps.d.items",
            "field": "category",
            "cmp": "eq",
            "value": "$param.category"
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.o0",
            "fields": [
                "identifier",
                "name",
                "category",
                "view_types",
                "has_collection"
            ]
        }
    ],
    "output": {
        "value": {
            "total": "$steps.d.total",
            "count": "$steps.o0|count",
            "definitions": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "total",
                "count",
                "definitions"
            ],
            "properties": {
                "total": {
                    "type": "integer"
                },
                "count": {
                    "type": "integer"
                },
                "definitions": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Container blocks",
            "params": {
                "category": "container"
            }
        },
        {
            "title": "Form blocks",
            "params": {
                "category": "form"
            }
        },
        {
            "title": "Listing blocks",
            "params": {
                "category": "listing"
            }
        },
        {
            "title": "Media blocks",
            "params": {
                "category": "media"
            }
        },
        {
            "title": "Navigation blocks",
            "params": {
                "category": "navigation"
            }
        },
        {
            "title": "Text blocks",
            "params": {
                "category": "text"
            }
        }
    ]
}
