{
    "name": "layout.blocks.container",
    "title": "Container blocks",
    "purpose": "The block definitions of the category container.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "layouts",
        "blocks",
        "container"
    ],
    "use_case": "Choosing a container block",
    "parameters": {},
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "layout_block_definitions"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "d",
            "unit": "layout_block_definitions",
            "args": {}
        },
        {
            "id": "o0",
            "op": "where",
            "from": "$steps.d.items",
            "field": "category",
            "cmp": "eq",
            "value": "container"
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.o0",
            "fields": [
                "identifier",
                "name",
                "category",
                "view_types",
                "has_collection"
            ]
        }
    ],
    "output": {
        "value": {
            "total": "$steps.d.total",
            "count": "$steps.o0|count",
            "definitions": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "total",
                "count",
                "definitions"
            ],
            "properties": {
                "total": {
                    "type": "integer"
                },
                "count": {
                    "type": "integer"
                },
                "definitions": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With the defaults",
            "params": {}
        }
    ]
}
