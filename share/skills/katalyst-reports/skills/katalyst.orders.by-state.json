{
    "name": "katalyst.orders.by-state",
    "title": "Orders per state",
    "purpose": "How many shop orders are paid, pending, cancelled and so on.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "katalyst",
        "hosting",
        "orders",
        "shop"
    ],
    "use_case": "Shop review",
    "parameters": {},
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "katalyst_orders_list"
        ],
        "programs": [
            "katalyst"
        ],
        "wave": "A"
    },
    "guards": [
        {
            "policy": "tron/katalyst_read"
        }
    ],
    "steps": [
        {
            "id": "l",
            "unit": "katalyst_orders_list",
            "args": {
                "limit": 200
            }
        },
        {
            "id": "g",
            "op": "group",
            "from": "$steps.l.items",
            "by": "state"
        }
    ],
    "output": {
        "value": {
            "orders": "$steps.l.total",
            "per_state": "$steps.g"
        },
        "schema": {
            "type": "object",
            "required": [
                "orders",
                "per_state"
            ],
            "properties": {
                "orders": {
                    "type": "integer"
                },
                "per_state": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With the defaults",
            "params": {}
        }
    ]
}
