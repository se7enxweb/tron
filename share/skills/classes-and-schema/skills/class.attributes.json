{
    "name": "class.attributes",
    "title": "Attributes of a class",
    "purpose": "The attributes of a content class in order: identifier, name, datatype and whether required, searchable and translatable.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "classes",
        "schema",
        "attributes"
    ],
    "use_case": "Before editing a class or writing a template",
    "parameters": {
        "identifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,100}$",
            "default": "ng_article",
            "description": "A class identifier.",
            "examples": [
                "ng_article"
            ]
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "class_describe"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "c",
            "unit": "class_describe",
            "args": {
                "identifier": "$param.identifier"
            }
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.c.attributes",
            "fields": [
                "identifier",
                "name",
                "datatype",
                "required",
                "searchable",
                "translatable",
                "category"
            ]
        }
    ],
    "output": {
        "value": {
            "class": "$steps.c.identifier",
            "name": "$steps.c.name",
            "count": "$steps.c.attributes|count",
            "attributes": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "class",
                "name",
                "count",
                "attributes"
            ],
            "properties": {
                "class": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "count": {
                    "type": "integer"
                },
                "attributes": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With identifier ng_article",
            "params": {
                "identifier": "ng_article"
            }
        },
        {
            "title": "With identifier folder",
            "params": {
                "identifier": "folder"
            }
        }
    ]
}
