{
    "name": "class.containers",
    "title": "Container or leaf classes",
    "purpose": "The content classes that can hold children, or with containers false those that cannot, with their object counts.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "classes",
        "inventory",
        "structure"
    ],
    "use_case": "Understanding the content tree model",
    "parameters": {
        "containers": {
            "type": "boolean",
            "default": true,
            "description": "true: the container classes; false: the leaf classes.",
            "examples": [
                true,
                false
            ]
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "class_list"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "l",
            "unit": "class_list",
            "args": {
                "limit": 200
            }
        },
        {
            "id": "o0",
            "op": "where",
            "from": "$steps.l.items",
            "field": "is_container",
            "cmp": "eq",
            "value": "$param.containers"
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.o0",
            "fields": [
                "identifier",
                "name",
                "object_count"
            ]
        }
    ],
    "output": {
        "value": {
            "classes": "$steps.l.total",
            "count": "$steps.o0|count",
            "items": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "classes",
                "count",
                "items"
            ],
            "properties": {
                "classes": {
                    "type": "integer",
                    "description": "Classes in all"
                },
                "count": {
                    "type": "integer"
                },
                "items": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Container classes",
            "params": {
                "containers": true
            }
        },
        {
            "title": "Leaf classes",
            "params": {
                "containers": false
            }
        }
    ]
}
