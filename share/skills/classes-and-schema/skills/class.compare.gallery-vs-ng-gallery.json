{
    "name": "class.compare.gallery-vs-ng-gallery",
    "title": "Compare gallery and ng_gallery",
    "purpose": "The differences between the classes gallery and ng_gallery: attributes only in one of them and attributes that differ.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "classes",
        "schema",
        "diff",
        "migration"
    ],
    "use_case": "Moving content from the classic classes to the new ones",
    "parameters": {},
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "class_diff"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "d",
            "unit": "class_diff",
            "args": {
                "identifier": "gallery",
                "other": "ng_gallery"
            }
        },
        {
            "id": "kinds",
            "op": "group",
            "from": "$steps.d.items",
            "by": "change"
        }
    ],
    "output": {
        "value": {
            "a": "gallery",
            "b": "ng_gallery",
            "counts": "$steps.d.counts",
            "per_change": "$steps.kinds",
            "differences": "$steps.d.items"
        },
        "schema": {
            "type": "object",
            "required": [
                "a",
                "b",
                "counts",
                "per_change",
                "differences"
            ],
            "properties": {
                "a": {
                    "type": "string"
                },
                "b": {
                    "type": "string"
                },
                "counts": {
                    "type": "object"
                },
                "per_change": {
                    "type": "array"
                },
                "differences": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With the defaults",
            "params": {}
        }
    ]
}
