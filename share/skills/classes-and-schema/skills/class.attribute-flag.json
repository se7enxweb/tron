{
    "name": "class.attribute-flag",
    "title": "Attributes by a flag",
    "purpose": "The attributes of a content class with a flag set or not set: information collectors (forms), searchable, translatable or required.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "classes",
        "attributes",
        "inventory"
    ],
    "use_case": "Reviewing what is collected, searched, translated or required",
    "parameters": {
        "flag": {
            "type": "string",
            "enum": [
                "information_collector",
                "searchable",
                "translatable",
                "required"
            ],
            "default": "required",
            "description": "The flag: information_collector, searchable, translatable or required.",
            "examples": [
                "required",
                "searchable"
            ],
            "short": "-f"
        },
        "set": {
            "type": "boolean",
            "default": true,
            "description": "true: the attributes with the flag; false: those without it.",
            "examples": [
                true,
                false
            ]
        },
        "identifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,100}$",
            "default": "ng_article",
            "description": "A class identifier.",
            "examples": [
                "ng_article"
            ]
        }
    },
    "requires": {
        "tron": "0.0.0.15",
        "units": [
            "class_describe"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "c",
            "unit": "class_describe",
            "args": {
                "identifier": "$param.identifier"
            }
        },
        {
            "id": "o0",
            "op": "where",
            "from": "$steps.c.attributes",
            "field": "$param.flag",
            "cmp": "eq",
            "value": "$param.set"
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.o0",
            "fields": [
                "identifier",
                "name",
                "datatype"
            ]
        }
    ],
    "output": {
        "value": {
            "class": "$steps.c.identifier",
            "name": "$steps.c.name",
            "count": "$steps.o0|count",
            "attributes": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "class",
                "name",
                "count",
                "attributes"
            ],
            "properties": {
                "class": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "count": {
                    "type": "integer"
                },
                "attributes": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Information collectors",
            "params": {
                "identifier": "ng_article",
                "flag": "information_collector",
                "set": true
            }
        },
        {
            "title": "Attributes left out of search",
            "params": {
                "identifier": "ng_article",
                "flag": "searchable",
                "set": false
            }
        },
        {
            "title": "Attributes not translated",
            "params": {
                "identifier": "ng_article",
                "flag": "translatable",
                "set": false
            }
        },
        {
            "title": "Required attributes",
            "params": {
                "identifier": "ng_article",
                "flag": "required",
                "set": true
            }
        }
    ]
}
