{
    "name": "content.class.count",
    "title": "How many of a class",
    "purpose": "How many nodes of one or more classes there are below a node.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "content",
        "inventory",
        "counts"
    ],
    "use_case": "Sizing a migration or a cleanup",
    "parameters": {
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 1,
            "description": "The node to start from.",
            "examples": [
                1
            ]
        },
        "class": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+(\\s*,\\s*[A-Za-z0-9_]+)*$",
            "maxLength": 500,
            "default": "ng_article",
            "description": "A class identifier, or a comma list of them.",
            "examples": [
                "ng_article",
                "image,file"
            ],
            "short": "-c"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "node_find"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "f",
            "unit": "node_find",
            "args": {
                "node_id": "$param.node_id",
                "class": "$param.class",
                "limit": 1
            }
        }
    ],
    "output": {
        "value": {
            "class": "$param.class",
            "node_id": "$param.node_id",
            "count": "$steps.f.total"
        },
        "schema": {
            "type": "object",
            "required": [
                "class",
                "node_id",
                "count"
            ],
            "properties": {
                "class": {
                    "type": "string"
                },
                "node_id": {
                    "type": "integer"
                },
                "count": {
                    "type": "integer"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With class ng_article",
            "params": {
                "class": "ng_article"
            }
        },
        {
            "title": "With class image,file",
            "params": {
                "class": "image,file"
            }
        }
    ]
}
