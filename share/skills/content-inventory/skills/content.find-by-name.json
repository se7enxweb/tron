{
    "name": "content.find-by-name",
    "title": "Find content by name",
    "purpose": "Finds nodes whose name holds the given text, below a node.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "content",
        "search"
    ],
    "use_case": "Finding a page by its title",
    "parameters": {
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 2,
            "description": "The node to start from.",
            "examples": [
                2
            ]
        },
        "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Part of the name.",
            "examples": [
                "Privacy",
                "Recipe"
            ],
            "default": "Privacy"
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "At most this many rows in the answer.",
            "examples": [
                5,
                10
            ],
            "short": "-n"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "node_find"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "find",
            "unit": "node_find",
            "args": {
                "node_id": "$param.node_id",
                "name": "$param.text",
                "limit": "$param.limit"
            }
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.find.items",
            "fields": [
                "node_id",
                "name",
                "class_identifier",
                "url_alias"
            ]
        }
    ],
    "output": {
        "value": {
            "total": "$steps.find.total",
            "shown": "$steps.rows|count",
            "nodes": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "total",
                "shown",
                "nodes"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "description": "How many match in all"
                },
                "shown": {
                    "type": "integer"
                },
                "nodes": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With text Privacy",
            "params": {
                "text": "Privacy"
            }
        },
        {
            "title": "With text Fit",
            "params": {
                "text": "Fit"
            }
        }
    ]
}
