{
    "name": "content.missing-url-alias",
    "title": "Nodes without a URL alias",
    "purpose": "Lists the nodes below a node that have no URL alias, so they only open as content/view/full/<id>.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "content",
        "seo",
        "urls"
    ],
    "use_case": "SEO and link hygiene",
    "parameters": {
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 2,
            "description": "The node to start from.",
            "examples": [
                2
            ]
        },
        "class": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+(\\s*,\\s*[A-Za-z0-9_]+)*$",
            "maxLength": 500,
            "default": "ng_article,ng_news,ng_blog_post,ng_landing_page,folder",
            "description": "A class identifier, or a comma list of them.",
            "examples": [
                "ng_article,ng_news,ng_blog_post,ng_landing_page,folder"
            ],
            "short": "-c"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "node_find"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "find",
            "unit": "node_find",
            "args": {
                "node_id": "$param.node_id",
                "class": "$param.class",
                "limit": 50
            }
        },
        {
            "id": "o0",
            "op": "where",
            "from": "$steps.find.items",
            "field": "url_alias",
            "cmp": "empty"
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.o0",
            "fields": [
                "node_id",
                "name",
                "class_identifier"
            ]
        }
    ],
    "output": {
        "value": {
            "total": "$steps.find.total",
            "shown": "$steps.rows|count",
            "nodes": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "total",
                "shown",
                "nodes"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "description": "How many match in all"
                },
                "shown": {
                    "type": "integer"
                },
                "nodes": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "With the defaults",
            "params": {}
        }
    ]
}
