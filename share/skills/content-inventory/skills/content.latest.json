{
    "name": "content.latest",
    "title": "Latest content of a class",
    "purpose": "The nodes of one class most recently published below a node (the whole site by default), newest first, with how many there are in all.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "content",
        "inventory",
        "latest"
    ],
    "use_case": "What was published lately",
    "parameters": {
        "class": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,100}$",
            "default": "article",
            "description": "The class identifier, e.g. article, image or ng_news.",
            "examples": [
                "article",
                "ng_news"
            ],
            "short": "-c"
        },
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 2,
            "description": "Search below this node.",
            "examples": [
                2
            ]
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "At most this many rows in the answer.",
            "examples": [
                5,
                10
            ],
            "short": "-n"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "node_find"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "find",
            "unit": "node_find",
            "args": {
                "class": "$param.class",
                "node_id": "$param.node_id",
                "limit": "$param.limit",
                "sort": "published",
                "order": "desc"
            }
        },
        {
            "id": "rows",
            "op": "pick",
            "from": "$steps.find.items",
            "fields": [
                "node_id",
                "name",
                "url_alias",
                "published",
                "modified"
            ]
        }
    ],
    "output": {
        "value": {
            "total": "$steps.find.total",
            "shown": "$steps.rows|count",
            "nodes": "$steps.rows"
        },
        "schema": {
            "type": "object",
            "required": [
                "total",
                "shown",
                "nodes"
            ],
            "properties": {
                "total": {
                    "type": "integer",
                    "description": "How many match in all"
                },
                "shown": {
                    "type": "integer"
                },
                "nodes": {
                    "type": "array"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Latest classic articles",
            "params": {
                "class": "article"
            }
        },
        {
            "title": "Latest newsletter articles",
