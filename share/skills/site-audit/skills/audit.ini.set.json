{
    "name": "audit.ini.set",
    "title": "A setting is set",
    "purpose": "Checks that a setting (file, block, setting) has a value for a siteaccess. Answers the value, where it is set and ok true or false.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "ini",
        "check",
        "basics"
    ],
    "use_case": "Pre-launch and periodic site audit",
    "parameters": {
        "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}\\.ini$",
            "default": "site.ini",
            "description": "The INI file, e.g. site.ini.",
            "examples": [
                "site.ini",
                "content.ini"
            ],
            "short": "-f"
        },
        "block": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "default": "SiteSettings",
            "description": "The block, e.g. SiteSettings.",
            "examples": [
                "SiteSettings",
                "MailSettings"
            ]
        },
        "setting": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "default": "SiteName",
            "description": "The setting, e.g. SiteName.",
            "examples": [
                "SiteName",
                "AdminEmail"
            ]
        },
        "siteaccess": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "The siteaccess whose settings count (default: the current one).",
            "examples": [
                "site",
                "admin"
            ],
            "short": "-s",
            "default": "site"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "ini_resolve"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "r",
            "unit": "ini_resolve",
            "args": {
                "file": "$param.file",
                "block": "$param.block",
                "setting": "$param.setting",
                "siteaccess": "$param.siteaccess"
            }
        },
        {
            "id": "ok",
            "op": "test",
            "value": "$steps.r.value",
            "cmp": "notempty"
        }
    ],
    "output": {
        "value": {
            "setting": "{{$param.file}} [{{$param.block}}] {{$param.setting}}",
            "siteaccess": "$steps.r.siteaccess",
            "value": "$steps.r.value",
            "winner": "$steps.r.winner",
            "ok": "$steps.ok",
            "expected": "set"
        },
        "schema": {
            "type": "object",
            "required": [
                "setting",
                "siteaccess",
                "value",
                "winner",
                "ok",
                "expected"
            ],
            "properties": {
                "setting": {
                    "type": "string"
                },
                "siteaccess": {
                    "type": "string"
                },
                "value": [],
                "winner": {
                    "description": "The file whose value counts"
                },
                "ok": {
                    "type": "boolean",
                    "description": "Whether the value is what it should be"
                },
                "expected": {
                    "type": "string"
                }
            }
        }
    },
    "examples": [
        {
            "title": "Administrator address is set",
            "params": {
                "siteaccess": "site",
                "file": "site.ini",
                "block": "MailSettings",
                "setting": "AdminEmail"
            }
        },
        {
            "title": "Mail transport is set",
            "params": {
                "siteaccess": "site",
                "file": "site.ini",
                "block": "MailSettings",
                "setting": "Transport"
            }
        },
        {
            "title": "Search engine is set",
            "params": {
                "siteaccess": "site",
                "file": "site.ini",
                "block": "SearchSettings",
                "setting": "SearchEngine"
            }
        },
        {
            "title": "Session timeout is set",
            "params": {
                "siteaccess": "site",
                "file": "site.ini",
                "block": "Session",
                "setting": "SessionTimeout"
            }
        },
        {
            "title": "Site name is set",
            "params": {
                "siteaccess": "site",
                "file": "site.ini",
                "block": "SiteSettings",
                "setting": "SiteName"
            }
        },
        {
            "title": "Site URL is set",
            "params": {
                "siteaccess": "site",
                "file": "site.ini",
                "block": "SiteSettings",
                "setting": "SiteURL"
            }
        },
        {
            "title": "Version history limit is set",
            "params": {
                "siteaccess": "site",
                "file": "content.ini",
                "block": "VersionManagement",
                "setting": "DefaultVersionHistoryLimit"
            }
        }
    ]
}
