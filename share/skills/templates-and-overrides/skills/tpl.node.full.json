{
    "name": "tpl.node.full",
    "title": "Template of a node, full view",
    "purpose": "Which template renders a node in the full view on a siteaccess, through which override rule, and which overrides were tried.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "templates",
        "overrides",
        "full"
    ],
    "use_case": "Which template renders this?",
    "parameters": {
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 2,
            "description": "The node.",
            "examples": [
                2
            ]
        },
        "siteaccess": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "The siteaccess whose settings count (default: the current one).",
            "examples": [
                "site",
                "admin"
            ],
            "short": "-s",
            "default": "site"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "tpl_resolve"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "r",
            "unit": "tpl_resolve",
            "args": {
                "node_id": "$param.node_id",
                "view": "full",
                "siteaccess": "$param.siteaccess"
            }
        },
        {
            "id": "matched",
            "op": "where",
            "from": "$steps.r.overrides",
            "field": "failed",
            "cmp": "empty"
        }
    ],
    "output": {
        "value": {
            "template": "$steps.r.template",
            "siteaccess": "$steps.r.siteaccess",
            "winner": "$steps.r.winner",
            "overrides_tried": "$steps.r.overrides|count",
            "designs": "$steps.r.designs"
        },
        "schema": {
            "type": "object",
            "required": [
                "template",
                "siteaccess",
                "winner",
                "overrides_tried",
                "designs"
            ],
            "properties": {
                "template": {
                    "type": "string"
                },
                "siteaccess": {
                    "type": "string"
                },
                "winner": [],
                "overrides_tried": {
                    "type": "integer"
                },
                "designs": []
            }
        }
    },
    "examples": [
        {
            "title": "With node_id 2",
            "params": {
                "node_id": 2
            }
        },
        {
            "title": "With node_id 75, siteaccess bold",
            "params": {
                "node_id": 75,
                "siteaccess": "bold"
            }
        }
    ]
}
