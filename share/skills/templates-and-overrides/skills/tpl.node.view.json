{
    "name": "tpl.node.view",
    "title": "Template of a node in a view",
    "purpose": "Which template renders a node in a view (full, line, embed, listitem ...) on a siteaccess, through which override rule, and which overrides were tried.",
    "version": "0.0.0.1",
    "author": "7x",
    "license": "GPL-2.0-or-later",
    "tags": [
        "templates",
        "overrides",
        "views"
    ],
    "use_case": "Why does this node look like that?",
    "parameters": {
        "view": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$",
            "default": "full",
            "description": "The view mode, e.g. full, line, embed or listitem.",
            "examples": [
                "full",
                "line"
            ],
            "short": "-v"
        },
        "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999,
            "default": 2,
            "description": "The node.",
            "examples": [
                2
            ]
        },
        "siteaccess": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "The siteaccess whose settings count (default: the current one).",
            "examples": [
                "site",
                "admin"
            ],
            "short": "-s",
            "default": "site"
        }
    },
    "requires": {
        "tron": "0.0.0.7",
        "units": [
            "tpl_resolve"
        ],
        "wave": "A"
    },
    "steps": [
        {
            "id": "r",
            "unit": "tpl_resolve",
            "args": {
                "node_id": "$param.node_id",
                "view": "$param.view",
                "siteaccess": "$param.siteaccess"
            }
        },
        {
            "id": "matched",
            "op": "where",
            "from": "$steps.r.overrides",
            "field": "failed",
            "cmp": "empty"
        }
    ],
    "output": {
        "value": {
            "template": "$steps.r.template",
            "siteaccess": "$steps.r.siteaccess",
            "winner": "$steps.r.winner",
            "overrides_tried": "$steps.r.overrides|count",
            "designs": "$steps.r.designs"
        },
        "schema": {
            "type": "object",
            "required": [
                "template",
                "siteaccess",
                "winner",
                "overrides_tried",
                "designs"
            ],
            "properties": {
                "template": {
                    "type": "string"
                },
                "siteaccess": {
                    "type": "string"
                },
                "winner": [],
                "overrides_tried": {
                    "type": "integer"
                },
                "designs": []
            }
        }
    },
    "examples": [
        {
            "title": "Template of a node, embedded view",
            "params": {
                "node_id": 2,
                "view": "embed"
            }
        },
        {
            "title": "Template of a node, full view",
            "params": {
                "node_id": 2,
                "view": "full"
            }
        },
        {
            "title": "Template of a node, line view",
            "params": {
                "node_id": 2,
                "view": "line"
            }
        },
        {
            "title": "Template of a node, list item view",
            "params": {
                "node_id": 2,
                "view": "listitem"
            }
        }
    ]
}
